<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

 <!-- HEADER -->
 <TextView
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:text="Peta Laporan"
     android:textSize="23sp"
     android:textStyle="bold"
     android:textColor="#111111"
     android:paddingStart="20dp"
     android:paddingEnd="20dp"
     android:paddingTop="16dp"
     android:paddingBottom="12dp" />

 <!-- SEARCH -->
 <EditText
     android:id="@+id/etMapSearch"
     android:layout_width="match_parent"
     android:layout_height="46dp"
     android:layout_marginStart="20dp"
     android:layout_marginEnd="20dp"
     android:layout_marginBottom="12dp"
     android:hint="⌕  Cari lokasi laporan"
     android:singleLine="true"
     android:textSize="13sp"
     android:paddingStart="16dp"
     android:paddingEnd="16dp"
     android:textColor="#222222"
     android:textColorHint="#687386"
     android:background="@drawable/bg_map_search"
     android:inputType="text" />

 <!-- AREA PETA -->
 <FrameLayout
     android:id="@+id/mapContainer"
     android:layout_width="match_parent"
     android:layout_height="240dp"
     android:layout_marginStart="20dp"
     android:layout_marginEnd="20dp"
     android:background="@drawable/map"
     android:clipToOutline="true">

  <!--
  Tempatkan GoogleMap/SupportMapFragment
  atau ImageView peta di dalam area ini.
  -->

  <TextView
      android:id="@+id/tvMapPlaceholder"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center"
      android:text="Peta akan ditampilkan di sini"
      android:textColor="#687386"
      android:textSize="13sp" />

 </FrameLayout>

 <!-- JUDUL DAFTAR -->
 <TextView
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginStart="20dp"
     android:layout_marginTop="16dp"
     android:layout_marginEnd="20dp"
     android:layout_marginBottom="8dp"
     android:text="Laporan di sekitar"
     android:textColor="#111111"
     android:textSize="19sp"
     android:textStyle="bold" />

 <!-- DAFTAR LAPORAN -->
 <ScrollView
     android:layout_width="match_parent"
     android:layout_height="0dp"
     android:layout_weight="1"
     android:fillViewport="false"
     android:overScrollMode="never">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="20dp"
      android:paddingEnd="20dp"
      android:paddingBottom="12dp">

   <!-- LAPORAN 1 -->
   <LinearLayout
       android:id="@+id/mapReport1"
       android:layout_width="match_parent"
       android:layout_height="68dp"
       android:layout_marginBottom="8dp"
       android:background="@drawable/bg_map_report"
       android:gravity="center_vertical"
       android:orientation="horizontal"
       android:paddingStart="12dp"
       android:paddingEnd="12dp"
       android:clickable="true"
       android:focusable="true">

    <ImageView
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:src="@drawable/ic_road"
        android:scaleType="fitCenter"
        android:contentDescription="Jalan rusak" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

     <TextView
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:text="Jalan berlubang"
         android:textColor="#111111"
         android:textSize="14sp"
         android:textStyle="bold" />

     <TextView
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="3dp"
         android:text="Jl. Melati"
         android:textColor="#687386"
         android:textSize="12sp" />

    </LinearLayout>

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/arrow_forward_ios_24"
        android:contentDescription="Detail laporan" />

   </LinearLayout>

   <!-- LAPORAN 2 -->
   <LinearLayout
       android:id="@+id/mapReport2"
       android:layout_width="match_parent"
       android:layout_height="68dp"
       android:layout_marginBottom="8dp"
       android:background="@drawable/bg_map_report"
       android:gravity="center_vertical"
       android:orientation="horizontal"
       android:paddingStart="12dp"
       android:paddingEnd="12dp"
       android:clickable="true"
       android:focusable="true">

    <ImageView
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:src="@drawable/street_light"
        android:scaleType="fitCenter"
        android:contentDescription="Lampu jalan mati" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

     <TextView
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:text="Lampu jalan mati"
         android:textColor="#111111"
         android:textSize="14sp"
         android:textStyle="bold" />

     <TextView
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="3dp"
         android:text="Jl. Sudirman"
         android:textColor="#687386"
         android:textSize="12sp" />

    </LinearLayout>

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/arrow_forward_ios_24"
        android:contentDescription="Detail laporan" />

   </LinearLayout>

   <!-- LAPORAN 3 -->
   <LinearLayout
       android:id="@+id/mapReport3"
       android:layout_width="match_parent"
       android:layout_height="68dp"
       android:layout_marginBottom="8dp"
       android:background="@drawable/bg_map_report"
       android:gravity="center_vertical"
       android:orientation="horizontal"
       android:paddingStart="12dp"
       android:paddingEnd="12dp"
       android:clickable="true"
       android:focusable="true">

    <ImageView
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:src="@drawable/ic_drainage"
        android:scaleType="fitCenter"
        android:contentDescription="Drainase tersumbat" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

     <TextView
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:text="Drainase tersumbat"
         android:textColor="#111111"
         android:textSize="14sp"
         android:textStyle="bold" />

     <TextView
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="3dp"
         android:text="Jl. Akasia"
         android:textColor="#687386"
         android:textSize="12sp" />

    </LinearLayout>

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/arrow_forward_ios_24"
        android:contentDescription="Detail laporan" />

   </LinearLayout>

  </LinearLayout>
 </ScrollView>

 <!-- NAVIGASI BAWAH -->
 <LinearLayout
     android:layout_width="match_parent"
     android:layout_height="52dp"
     android:background="#FFFFFF"
     android:elevation="6dp"
     android:gravity="center_vertical"
     android:orientation="horizontal">

  <TextView
      android:id="@+id/navBeranda"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="center"
      android:text="⌂\nBeranda"
      android:textColor="#222222"
      android:textSize="10sp" />

  <TextView
      android:id="@+id/navPeta"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="center"
      android:text="◎\nPeta"
      android:textColor="#00BFA5"
      android:textStyle="bold"
      android:textSize="10sp" />

  <TextView
      android:id="@+id/navLaporan"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="center"
      android:text="▤\nLaporan"
      android:textColor="#222222"
      android:textSize="10sp" />

  <TextView
      android:id="@+id/navProfil"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="center"
      android:text="♙\nProfil"
      android:textColor="#222222"
      android:textSize="10sp" />

 </LinearLayout>

</LinearLayout>
