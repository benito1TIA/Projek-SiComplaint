<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pine_green"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".SplashActivity">

    <!-- Logo Container -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Logo Icon -->
        <ImageView
            android:id="@+id/imgSplashLogo"
            android:layout_width="183dp"
            android:layout_height="156dp"
            android:contentDescription="SiComplaint Logo"
            android:src="@drawable/sicomplaintlogo" />

    </LinearLayout>

    <!-- Tagline -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Laporkan kerusakan fasilitas umum di sekitar Anda."
        android:textColor="#D4EDE1"
        android:textSize="13sp"
        android:gravity="center"
        android:paddingHorizontal="40dp" />

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/progressSplash"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:indeterminateTint="#FFFFFF" />

</LinearLayout>
